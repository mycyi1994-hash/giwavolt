# Copy this file to ".env" and fill in your testnet wallet's private key.
# This wallet pays gas to deploy and becomes the token owner + faucet wallet.
# Use a throwaway TEST wallet only — never a key that holds real money.
PRIVATE_KEY=0xyourTestWalletPrivateKey

# Which chain to deploy to. Every deploy/verify script reads it:
#   NETWORK=bscTestnet npm run deploy:testkrw
# One of: giwaSepolia (default), bscTestnet, opbnbTestnet. It has to name the
# same chain as the app's NEXT_PUBLIC_CHAIN, or the vault rejects every
# withdrawal voucher the server signs.
# NETWORK=giwaSepolia

# RPC overrides — each has a public default, so leave them out unless you need
# a private node.
# GIWA_RPC_URL=https://sepolia-rpc.giwa.io
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# OPBNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org

# Source verification. Blockscout (Giwa) ignores the key. The BscScan-family
# explorers do not: verifying on BSC or opBNB needs a real key from bscscan.com,
# or the request comes back rejected rather than unverified.
# BLOCKSCOUT_API_KEY=blockscout
# BSCSCAN_API_KEY=
