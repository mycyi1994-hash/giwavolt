# Giwa Sepolia RPC (default is fine)
NEXT_PUBLIC_GIWA_RPC_URL=https://sepolia-rpc.giwa.io

# WalletConnect project id — get one free at https://cloud.walletconnect.com
# Injected wallets (MetaMask, Rainbow, Coinbase) work without it; the
# WalletConnect QR option needs a real id.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Test KRW (tKRW) off-chain play balance ---
# REAL mode uses an off-chain tKRW balance (server ledger) — no signatures to
# play. "GET TEST KRW" credits the balance; WITHDRAW sends real on-chain tKRW
# back to the player's wallet (the house wallet signs that transfer).

# tKRW token address (public). Needed for WITHDRAW. Deploy with:
#   cd game/contracts && npm run deploy:testkrw
NEXT_PUBLIC_TESTKRW_ADDRESS=

# House hot wallet that pays out withdrawals. NEVER prefix with NEXT_PUBLIC —
# it must stay server-side. Must hold tKRW (the deploy script seeds it). It does
# NOT need ETH unless someone withdraws (gas for the transfer).
FAUCET_PRIVATE_KEY=

# Optional tuning:
# FAUCET_DRIP_TKRW=1000000     # tKRW credited per "GET TEST KRW"
# FAUCET_COOLDOWN_MS=0         # cooldown between claims per address (0 = none)
