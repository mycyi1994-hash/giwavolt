# Giwa Sepolia RPC (default is fine)
NEXT_PUBLIC_GIWA_RPC_URL=https://sepolia-rpc.giwa.io

# WalletConnect project id — get one free at https://cloud.walletconnect.com
# Injected wallets (MetaMask, Rainbow, Coinbase) work without it; the
# WalletConnect QR option needs a real id.
NEXT_PUBLIC_WC_PROJECT_ID=

# SlideGame contract address (after you deploy game/contracts). Leave unset to
# stay in client-side demo mode.
NEXT_PUBLIC_SLIDE_ADDRESS=

# VoltTap contract address — enables Tap Trading REAL mode (instant on-chain
# bets, fixed 0.0001 ETH). Deploy with: cd game/contracts && npm run deploy:volttap
# then paste the address here and redeploy the web.
NEXT_PUBLIC_VOLTTAP_ADDRESS=

# --- Test KRW (tKRW) play-money token + faucet ---
# Token address (public). Deploy with: cd game/contracts && npm run deploy:testkrw
NEXT_PUBLIC_TESTKRW_ADDRESS=

# Server-side faucet hot wallet. NEVER prefix with NEXT_PUBLIC — it must stay
# on the server. This wallet must hold tKRW (the deploy script seeds it) and a
# little ETH for gas + dust distribution.
FAUCET_PRIVATE_KEY=
# Optional faucet tuning:
# FAUCET_DRIP_TKRW=1000000     # tKRW per claim
# FAUCET_DRIP_ETH=0.002        # gas ETH per claim (skipped if wallet already has it)
# FAUCET_COOLDOWN_MS=28800000  # 8h per address
